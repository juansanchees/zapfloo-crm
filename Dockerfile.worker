# Worker 24/7 do agent-engine (fusão Vendaval) — processo long-running fora do Next.
# Roda TS direto via tsx (sem build): o worker é I/O-bound e o cold start não importa.
# ponytail: imagem single-stage com devDeps (tsx precisa); multi-stage + prune é Fase 4.
FROM node:22-alpine

WORKDIR /app

# Procedência (doutrina de packaging, invariante 2).
LABEL org.opencontainers.image.source="https://github.com/juansanchees/zapfloo-crm" \
      org.opencontainers.image.licenses="MIT" \
      org.opencontainers.image.title="Zapfloo worker"

ARG APP_VERSION=dev
ENV APP_VERSION=$APP_VERSION
# pnpm fixado na versão do lockfile do repo (pnpm 10 bloquearia build scripts).
RUN corepack enable && corepack prepare pnpm@9.15.9 --activate

COPY package.json pnpm-lock.yaml ./
RUN pnpm install --frozen-lockfile

COPY . .

# O repo raiz é CommonJS por compatibilidade do Next, mas o renderer do PDF
# publica subpaths apenas na condição ESM. `tsx` transforma `.ts` conforme o
# package scope; sem este ajuste exclusivo da imagem worker ele tenta `require`
# em `@react-pdf/hyphenate/en-us` e o dreno inteiro cai no startup.
RUN node -e 'const fs=require("node:fs");const p=require("./package.json");p.type="module";fs.writeFileSync("package.json",JSON.stringify(p,null,2)+"\n")'

# Healthz do worker (bind 0.0.0.0 dentro do container).
EXPOSE 8787

CMD ["pnpm", "exec", "tsx", "workers/agent-worker/main.ts"]
