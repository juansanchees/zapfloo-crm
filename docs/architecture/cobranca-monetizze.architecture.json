{
  "schema_version": 1,
  "diagram_type": "architecture",
  "meta": {
    "title": "Cobrança Monetizze — uma decisão, inbound preservado, nenhum custo depois do bloqueio",
    "subtitle": "pausado sempre bloqueia; o interruptor libera os demais estados; platform admin tem bypass explícito",
    "output": "cobranca-monetizze.html",
    "quality_profile": "standard"
  },
  "lanes": [
    { "id": "estado", "label": "Estado comercial" },
    { "id": "decisao", "label": "Decisão única" },
    { "id": "entrada", "label": "Inbound preservado" },
    { "id": "saida", "label": "Saída e custo bloqueados" },
    { "id": "retorno", "label": "Laço visível" }
  ],
  "mainPath": ["assinatura", "adapter", "decidir", "layout", "billing"],
  "nodes": [
    { "id": "assinatura", "lane": "estado", "col": 0, "type": "database", "label": "organization_subscriptions + platform_billing_settings", "sublabel": "status, paid_through e interruptor; nenhuma borda reimplementa datas" },
    { "id": "platformadmin", "lane": "estado", "col": 0, "type": "database", "label": "platform_admins", "sublabel": "bypass explícito somente com revoked_at nulo" },
    { "id": "adapter", "lane": "decisao", "col": 1, "type": "service", "label": "lib/billing/acesso-server.ts", "sublabel": "mesma projeção via Supabase ou pg; erro commercial_access_blocked tipado" },
    { "id": "decidir", "lane": "decisao", "col": 2, "type": "service", "label": "decidirAcessoComercial", "sublabel": "pausado bloqueia mesmo com switch off; switch off libera os demais vencidos" },
    { "id": "wahawebhook", "lane": "entrada", "col": 2, "type": "api", "label": "webhook WAHA + lib/waha/ingest", "sublabel": "raw, conversa e mensagem persistem; não consulta cobrança" },
    { "id": "mediapersist", "lane": "entrada", "col": 3, "type": "service", "label": "media-persist-worker", "sublabel": "bytes recebidos continuam persistidos e idempotentes" },
    { "id": "layout", "lane": "saida", "col": 3, "type": "frontend", "label": "app/app/layout.tsx", "sublabel": "bloqueado navega somente em Plano e pagamentos; logout continua no shell" },
    { "id": "messages", "lane": "saida", "col": 3, "type": "api", "label": "POST /api/v1/messages", "sublabel": "nega humano/automação/IA antes de criar outbound queued" },
    { "id": "media", "lane": "saida", "col": 3, "type": "service", "label": "media-derive-worker", "sublabel": "nega antes de download, transcrição ou visão paga" },
    { "id": "credentials", "lane": "saida", "col": 3, "type": "service", "label": "resolveOrgLlmConfig", "sublabel": "nega antes de buscar/decriptar chave ou escolher provider" },
    { "id": "embed", "lane": "saida", "col": 3, "type": "service", "label": "lib/ai/embed.ts", "sublabel": "cobre busca/indexação RAG antes de embed()" },
    { "id": "workersai", "lane": "saida", "col": 3, "type": "service", "label": "ai-response + ai-sentiment workers", "sublabel": "nega antes de generateText/generateObject" },
    { "id": "runtime", "lane": "saida", "col": 3, "type": "service", "label": "runtime agent + onboarding montarQuadro", "sublabel": "nega os generateText diretos antes do modelo" },
    { "id": "transportes", "lane": "saida", "col": 4, "type": "external", "label": "WAHA / Meta / modelo / mídia paga", "sublabel": "nenhum transporte ou provider é chamado depois do veto" },
    { "id": "redrive", "lane": "saida", "col": 3, "type": "service", "label": "session-reconciler + handoff-owner-alert", "sublabel": "redrive e alerta externo também param; aviso da plataforma não usa canal do tenant" },
    { "id": "billing", "lane": "retorno", "col": 4, "type": "frontend", "label": "/app/settings/billing", "sublabel": "única porta tenant liberada para explicar e regularizar" }
  ],
  "edges": [
    { "id": "e1", "from": "assinatura", "to": "adapter", "label": "projeta" },
    { "id": "e2", "from": "platformadmin", "to": "adapter", "label": "bypass explícito" },
    { "id": "e3", "from": "adapter", "to": "decidir", "label": "chama a função pura" },
    { "id": "e4", "from": "decidir", "to": "layout", "label": "nega navegação" },
    { "id": "e5", "from": "layout", "to": "billing", "label": "redireciona com saída de logout" },
    { "id": "e6", "from": "wahawebhook", "to": "mediapersist", "label": "persiste sem gate comercial" },
    { "id": "e7", "from": "decidir", "to": "messages", "label": "nega antes do queued" },
    { "id": "e8", "from": "decidir", "to": "media", "label": "nega antes do custo" },
    { "id": "e9", "from": "decidir", "to": "credentials", "label": "nega antes da credencial" },
    { "id": "e10", "from": "decidir", "to": "embed", "label": "nega antes do embedding" },
    { "id": "e11", "from": "decidir", "to": "workersai", "label": "nega antes do modelo" },
    { "id": "e12", "from": "decidir", "to": "runtime", "label": "nega antes do modelo" },
    { "id": "e13", "from": "decidir", "to": "redrive", "label": "nega antes do transporte" },
    { "id": "e14", "from": "messages", "to": "transportes", "label": "somente quando permitido" },
    { "id": "e15", "from": "media", "to": "transportes", "label": "somente quando permitido" },
    { "id": "e16", "from": "credentials", "to": "transportes", "label": "somente quando permitido" },
    { "id": "e17", "from": "embed", "to": "transportes", "label": "somente quando permitido" },
    { "id": "e18", "from": "workersai", "to": "transportes", "label": "somente quando permitido" },
    { "id": "e19", "from": "runtime", "to": "transportes", "label": "somente quando permitido" },
    { "id": "e20", "from": "redrive", "to": "transportes", "label": "somente quando permitido" }
  ],
  "inventory": [
    { "sink": "generateText", "path": "workers/media-derive-worker.ts", "guard": "exigirAcessoComercialViaPg antes de download e credencial" },
    { "sink": "generateObject", "path": "workers/ai-sentiment-worker.ts", "guard": "exigirAcessoComercialViaPg na entrada" },
    { "sink": "generateText", "path": "workers/ai-response-worker.ts", "guard": "exigirAcessoComercialViaPg na entrada" },
    { "sink": "sendMessage", "path": "lib/channels/adapters/waha.ts", "guard": "handler compartilhado; alerta externo tem gate próprio" },
    { "sink": "embed", "path": "lib/ai/embed.ts", "guard": "exigirAcessoComercial antes de resolver chave" },
    { "sink": "generateText", "path": "lib/ai/runtime/agent.ts", "guard": "exigirAcessoComercial antes do provider" },
    { "sink": "generateText", "path": "lib/agent-engine/edge/llm/run-model-call.ts", "guard": "resolveOrgLlmConfig é a porta obrigatória" },
    { "sink": "generateText", "path": "app/actions/onboarding/montarQuadro.ts", "guard": "exigirAcessoComercial antes do admin/modelo" },
    { "sink": "transcribe", "path": "lib/messaging/media/transcription.ts", "guard": "chamado pelo media-derive-worker já vetado" },
    { "sink": "transcribe", "path": "lib/messaging/media/derive.ts", "guard": "chamado pelo media-derive-worker já vetado" },
    { "sink": "transcribe", "path": "lib/messaging/media/video-derive.ts", "guard": "chamado pelo media-derive-worker já vetado" },
    { "sink": "sendMessage", "path": "lib/waha/send.ts", "guard": "helper sem chamador de produção; mantido no inventário" },
    { "sink": "redrive transport", "path": "lib/agent-engine/edge/crm/session-reconciler.ts", "guard": "exigirAcessoComercialViaPg antes de fetch" },
    { "sink": "owner alert transport", "path": "workers/handoff-owner-alert-worker.ts", "guard": "exigirAcessoComercialViaPg antes do adapter" }
  ]
}
